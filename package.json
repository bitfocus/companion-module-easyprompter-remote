{
	"name": "companion-module-easyprompter-remote",
	"version": "1.2.2",
	"private": true,
	"main": "dist/index.js",
	"type": "module",
	"license": "MIT",
	"homepage": "https://github.com/bitfocus/companion-module-easyprompter-remote#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-easyprompter-remote.git"
	},
	"bugs": {
		"url": "https://github.com/bitfocus/companion-module-easyprompter-remote/issues"
	},
	"author": "Michael Drob",
	"keywords": [
		"teleprompter",
		"prompter",
		"scroll",
		"broadcast",
		"companion-module",
		"bitfocus"
	],
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"build": "rimraf dist && yarn build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json -w",
		"package": "yarn build && companion-module-build",
		"lint:raw": "eslint",
		"lint": "yarn lint:raw ."
	},
	"dependencies": {
		"@companion-module/base": "^2.0.0",
		"socket.io-client": "^4.8.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.0",
		"@types/node": "^22.0.0",
		"eslint": "^9.0.0",
		"husky": "^9.0.0",
		"lint-staged": "^15.0.0",
		"prettier": "^3.0.0",
		"rimraf": "^6.0.0",
		"typescript": "~5.9.0",
		"typescript-eslint": "^8.0.0"
	},
	"packageManager": "yarn@4.17.0"
}
